<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.cardrail</groupId>
  <artifactId>cardrail-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>cardrail</name>
  <description>Card payment switch: ISO 8583 authorization, tokenization, stand-in processing, ledger, clearing</description>

  <modules>
    <module>cardrail-iso8583</module>
    <module>cardrail-vault</module>
    <module>cardrail-switch</module>
    <module>cardrail-gateway</module>
    <module>cardrail-loadgen</module>
    <module>cardrail-apisec</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Cucumber 7.34 needs JUnit Platform 1.13+; Boot 3.5 manages 5.12 -->
    <junit-jupiter.version>5.14.2</junit-jupiter.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jqwik.version>1.9.3</jqwik.version>
    <cucumber.version>7.34.9</cucumber.version>
    <springdoc.version>2.8.17</springdoc.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <archunit.version>1.4.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.cardrail</groupId>
        <artifactId>cardrail-iso8583</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.cardrail</groupId>
        <artifactId>cardrail-vault</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.cardrail</groupId>
        <artifactId>cardrail-gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.cardrail</groupId>
        <artifactId>cardrail-apisec</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot3</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
